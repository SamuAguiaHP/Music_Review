# Configurações do Servidor e JWT
JWT_SECRET="insira_sua_chave_jwt_aqui"
DATABASE_URL="postgresql://usuario:senha@localhost:5432/music_review_db?schema=public"

# Configurações do Spotify API
SPOTIFY_CLIENT_ID="insira_seu_client_id_aqui"
SPOTIFY_CLIENT_SECRET="insira_seu_client_secret_aqui"

# Configurações de E-mail (Mailtrap)
MAIL_HOST="sandbox.smtp.mailtrap.io"
MAIL_PORT=2525
MAIL_USER=insira_seu_user_aqui
MAIL_PASS=insira_sua_senha_aqui